Proceso ConversionTemperatura
    Definir celsius, fahrenheit, kelvin Como Real

    Escribir "Nombre: Juan Arevalo"
    Escribir "Grado: IVC - Clave: 3"
    Escribir "===Conversion de Temperatura==="

    Escribir "Ingrese la temperatura en grados Celsius:"
    Leer celsius

    fahrenheit <- (celsius * 9 / 5) + 32
    kelvin <- celsius + 273.15

    Escribir "Fahrenheit: ", fahrenheit
    Escribir "Celsius: ", celsius
    Escribir "Kelvin: ", kelvin
FinProceso
