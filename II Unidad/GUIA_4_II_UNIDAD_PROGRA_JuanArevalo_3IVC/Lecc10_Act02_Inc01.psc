Algoritmo Lecc10_Act02_Inc01
	Definir i Como Entero
	
	Escribir "====================================="
	Escribir "       PRIMEROS 20 MÚLTIPLOS DE 4"
	Escribir "====================================="
	
	Para i = 1 Hasta 20 Con Paso 1 Hacer
		Escribir "Múltiplo ", i, ": ", 4 * i
	FinPara
	
	Escribir "-------------------------------------"
	Escribir "Proceso finalizado."
FinAlgoritmo
