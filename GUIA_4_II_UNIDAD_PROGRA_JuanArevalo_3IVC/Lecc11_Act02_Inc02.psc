Algoritmo Lecc11_Act02_Inc02
	Definir numero Como Entero
	numero = 1
	
	Escribir "====================================="
	Escribir "       IMPARES ENTRE 1 Y 100"
	Escribir "====================================="
	Escribir "El programa mostrará todos los impares."
	Esperar Tecla
	
	Escribir "-------------------------------------"
	Repetir
		Escribir numero
		numero = numero + 2
	Hasta Que numero > 100
	
	Escribir "-------------------------------------"
	Escribir "Proceso finalizado."
FinAlgoritmo
